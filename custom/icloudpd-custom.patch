+# Apple 会反复重启照片索引任务（设备上传、照片 App 后台分析、共享库变动都会触发）：
+# 新任务一起，CheckIndexingState 就返回 RUNNING / progress=0，过一阵又回到 FINISHED / 100。
+# 上游对此做一次性快照，撞上 RUNNING 窗口就永久失败，成败全看运气。
+# 这里改成轮询等待。最长等待时间可用环境变量覆盖，设为 0 即恢复「不等待」的旧行为。
+_INDEXING_TIMEOUT_ENV = "ICLOUDPD_INDEXING_TIMEOUT"
+_DEFAULT_INDEXING_TIMEOUT = 300.0
+_INDEXING_POLL_INITIAL = 5.0
+_INDEXING_POLL_MAX = 30.0
+
+
+def _indexing_timeout_seconds() -> float:
+    """索引检查的最长等待秒数。默认 300，环境变量 ICLOUDPD_INDEXING_TIMEOUT 可覆盖。"""
+    raw = os.environ.get(_INDEXING_TIMEOUT_ENV)
+    if raw is None or raw.strip() == "":
+        return _DEFAULT_INDEXING_TIMEOUT
+    try:
+        value = float(raw)
+    except ValueError:
+        logger.warning(
+            "%s=%r 不是数字，回退到默认 %.0f 秒", _INDEXING_TIMEOUT_ENV, raw, _DEFAULT_INDEXING_TIMEOUT
+        )
+        return _DEFAULT_INDEXING_TIMEOUT
+    if value < 0:
+        return 0.0
+    return value
+
 
