+def _explicit_password_providers(args: Sequence[str]) -> bool:
+    """True when the command line itself listed the password providers."""
+    return any(
+        arg == "--password-provider" or arg.startswith("--password-provider=") for arg in args
+    )
+
+
+def _remember_successful_run(global_ns: GlobalConfig, user_nses: Sequence[UserConfig]) -> None:
+    """Keep the Apple ID and the download directory of a run that finished cleanly.
+
+    Least privilege: only those two values, and only from runs that really touch
+    the library. Preview and dry runs are skipped because they are typically
+    pointed at throwaway paths, and a configuration without both values has
+    nothing worth keeping. A multi-account run remembers its first configuration.
+    """
+    if global_ns.only_print_filenames:
+        return
+    for user_ns in user_nses:
+        if user_ns.dry_run or not user_ns.username or not user_ns.directory:
+            continue
+        remember.save(user_ns.username, user_ns.directory)
+        return
+
+
